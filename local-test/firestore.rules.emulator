rules_version = '2';

// NEVER DEPLOY: intentionally permissive rules for the LOCAL EMULATOR ONLY.
// These rules must not exist in any production deployment; they grant full
// access so local automated tests can run against the emulator.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
